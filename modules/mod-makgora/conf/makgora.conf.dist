# Mak'Gora module configuration
#

[worldserver]

########################################
# Mak'Gora
########################################
#
#    MakGora.Enable
#        Description: Master switch for the Mak'Gora system.
#        Default:     0 - Disabled
#                     1 - Enabled
#
MakGora.Enable = 0

#
#    MakGora.MaxLevel
#        Description: Classic Plus horizontal progression cap (level 60).
#        Default:     60
#
MakGora.MaxLevel = 60

#
#    MakGora.MinLevel
#        Description: Minimum level required to enter the Mak'Gora path.
#        Default:     60
#
MakGora.MinLevel = 60

#
#    MakGora.RequireSameFaction
#        Description: Challenger and opponent must share a faction.
#        Default:     1
#
MakGora.RequireSameFaction = 1

#
#    MakGora.PermadeathOnLoss
#        Description: Losing a bound Mak'Gora duel applies permanent death.
#        Default:     1
#
MakGora.PermadeathOnLoss = 1

#
#    MakGora.AnnounceWorld
#        Description: Broadcast coronation / ritual outcomes to the realm.
#        Default:     1
#
MakGora.AnnounceWorld = 1

#
#    MakGora.ChampionEntry
#        Description: Creature entry for the elite champion trial (custom NPC).
#                     0 disables the champion encounter until content is ready.
#        Default:     0
#
MakGora.ChampionEntry = 0

#
#    MakGora.AddonPrefix
#        Description: Client addon message prefix (must match Lua RegisterAddonMessagePrefix).
#        Default:     MakGora
#
MakGora.AddonPrefix = "MakGora"
